{
  "version": "0.2.0",
  "configurations": [
    {
      "name": ".NET Launch FileMonitorAlert",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build",
      "program": "${workspaceFolder}/bin/Debug/net10.0/FileMonitorAlert.dll",
      "args": [
        "${env:HOME}",
        "error",
        ".txt",
        "--ignoreCase",
        "--includeSubdirs"
      ],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "stopAtEntry": false
    }
  ]
}